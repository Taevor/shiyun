<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. 投影柔影（增强悬浮立体感） -->
    <path
        android:pathData="M30,73 C42,69 66,69 78,73 C71,76 37,76 30,73 Z"
        android:fillColor="#33000000" />

    <!-- 2. 底层古籍装帧衬底（温润宣纸古绢色） -->
    <!-- 左书页衬底 -->
    <path
        android:pathData="M54,71 C43,66 33,66 26,70 C25.5,63.5 32,58 54,62 Z"
        android:fillColor="#FFD8CBBA" />
    <!-- 右书页衬底 -->
    <path
        android:pathData="M54,71 C65,66 75,66 82,70 C82.5,63.5 76,58 54,62 Z"
        android:fillColor="#FFCEBEA8" />

    <!-- 3. 展开的主书卷（白玉宣纸明净素雅） -->
    <!-- 左主页 -->
    <path
        android:pathData="M54,69 C43,64 33,64 27,68 C27,61.5 33,56.5 54,60.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="27"
                android:startY="60"
                android:endX="54"
                android:endY="69"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFF9F7F2" />
                <item android:offset="1.0" android:color="#FFEFECE4" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 右主页 -->
    <path
        android:pathData="M54,69 C65,64 75,64 81,68 C81,61.5 75,56.5 54,60.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="60"
                android:endX="81"
                android:endY="69"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFEFECE4" />
                <item android:offset="1.0" android:color="#FFF6F4EE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. 书页中缝脊线 -->
    <path
        android:pathData="M54,60.5 L54,69"
        android:strokeWidth="0.8"
        android:strokeColor="#FFB3A48F"
        android:fillColor="#00000000" />

    <!-- 5. 书卷文字诗句暗纹（横画如墨香） -->
    <path
        android:pathData="M34,61.5 C38,60.5 44,61 48,62 M33,64.5 C37,63.5 43,64 49,65 M59,62 C63,61 69,60.5 74,61.5 M60,65 C64,64 70,63.5 75,64.5"
        android:strokeWidth="0.75"
        android:strokeColor="#FFCBBBA7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- 6. 舒卷升腾的如意祥云（诗意成云，行云流水） -->
    <!-- 祥云主浪涌 -->
    <path
        android:pathData="M54,59.5 C51,52 43,47 37,47 C30,47 26,51.5 26,57 C26,62 31,65 37,64.5 C40,64 42,62.5 43.5,60 C40.5,59 38.5,57.5 38.5,55 C38.5,52 41,50 44,50.5 C48,51 51.5,55 54,59.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="26"
                android:startY="47"
                android:endX="54"
                android:endY="65"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFCFAF6" />
                <item android:offset="1.0" android:color="#FFE8E2D4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 祥云上卷如意流云（回环入诗） -->
    <path
        android:pathData="M48,52 C45,43 41,35 47,29 C52.5,23.5 61,24 65.5,28.5 C70,33 69,40 64,43.5 C59.5,46.5 54.5,45 52,42 C50,39.5 51,36.5 54,35.5 C56.5,34.5 59.5,36 61,38.5 C62.5,41 61.5,43.5 58.5,44 C55,44.5 51.5,42 50,38 C48.5,33.5 51.5,29.5 56.5,29 C62,28.5 66.5,31.5 67.5,36.5 C68.5,42.5 63,48.5 56.5,51 C53.5,52 51,54.5 49,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="42"
                android:startY="24"
                android:endX="70"
                android:endY="58"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFDF9" />
                <item android:offset="0.6" android:color="#FFF3EFE6" />
                <item android:offset="1.0" android:color="#FFE3DCCE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 7. 金石印章（朱砂印·诗）—— 位于右上黄金分割点，点睛东方文韵 -->
    <!-- 红色印身 -->
    <path
        android:pathData="M66,30 h11 c1.6,0 2.5,0.9 2.5,2.5 v11 c0,1.6 -0.9,2.5 -2.5,2.5 h-11 c-1.6,0 -2.5,-0.9 -2.5,-2.5 v-11 c0,-1.6 0.9,-2.5 2.5,-2.5 z"
        android:fillColor="#FFC83B28" />

    <!-- 印章边框微凹感阴文描线 -->
    <path
        android:pathData="M65.8,31.8 h11.4 v11.4 h-11.4 z"
        android:strokeWidth="0.6"
        android:strokeColor="#22FFFFFF"
        android:fillColor="#00000000" />

    <!-- 篆刻“诗”字金石笔意（篆体言+寺） -->
    <!-- 左边“言”部 -->
    <path
        android:pathData="M67.8,34.5 h2.4 M67.4,36.2 h2.8 M67.4,37.8 h2.8 M67.5,39.5 h2.4 v2 h-2.4 z"
        android:strokeWidth="0.55"
        android:strokeColor="#FFFBF8F2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- 右边“寺”部 -->
    <path
        android:pathData="M74.5,33.5 v3.5 M72.8,35 h3.4 M72.3,37 h4.4 M74.8,37.8 v3.4 c0,0.8 -0.5,1.2 -1.2,1.2 M72.3,39.2 h4.4 M73.7,40.8 h1"
        android:strokeWidth="0.55"
        android:strokeColor="#FFFBF8F2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
