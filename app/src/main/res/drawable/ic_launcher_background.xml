<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. 黛墨天青渐变底色（取宋代汝窑温润青墨意蕴） -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="18"
                android:startY="12"
                android:endX="90"
                android:endY="96"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF1F2D3D" />
                <item android:offset="0.5" android:color="#FF17222E" />
                <item android:offset="1.0" android:color="#FF111922" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. 月晕流光（一轮空灵明月，隐喻举头望明月与千古诗心） -->
    <path
        android:pathData="M54,20 A34,34 0 1 0 54,88 A34,34 0 1 0 54,20 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="20"
                android:endX="54"
                android:endY="88"
                android:type="linear">
                <item android:offset="0.0" android:color="#1AFFFFFF" />
                <item android:offset="0.6" android:color="#0AFFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. 微晕细环（金石与玉璧隐纹） -->
    <path
        android:pathData="M54,24 A30,30 0 1 0 54,84 A30,30 0 1 0 54,24 Z"
        android:strokeWidth="0.8"
        android:strokeColor="#12FFFFFF"
        android:fillColor="#00000000" />
</vector>
